# --- Core ---
DATABASE_URL=sqlite:///./agrin.db
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
DEFAULT_COUNTRY=IN

# --- Auth: "dev" trusts the X-Dev-User header (local only); "firebase" verifies Firebase ID tokens ---
AUTH_MODE=dev
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-admin.json
ADMIN_API_KEY=change-me

# --- Google Earth Engine: "service_account" (prod) or "user" (`earthengine authenticate`) ---
EE_AUTH_MODE=user
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=
GEE_CLOUD_PROJECT=

# --- Gemini (plant diagnosis). Either an AI Studio key, or Vertex AI via the GCP project ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash,gemini-flash-lite-latest
GEMINI_USE_VERTEX=false
GCP_LOCATION=asia-south1

# --- Google Cloud Translation (dynamic content in 25+ languages) ---
TRANSLATE_API_KEY=

# --- Google Geocoding (fallback place search when OpenStreetMap has no match, e.g. small Indian villages) ---
GOOGLE_MAPS_API_KEY=
